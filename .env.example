# Copy to .env and adjust. Never commit .env.
# All variables are optional.

# HTTP listen port (default 8093)
PORT=8093

# Bind address. Prefer loopback for local use.
# Express default without HOST is all interfaces — set explicitly.
HOST=127.0.0.1

# SQLite database path (default ./data/invoicer.db)
DB_PATH=./data/invoicer.db
